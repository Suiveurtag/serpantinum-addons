diff --git a/linux/src/serpantinum.rs b/linux/src/serpantinum.rs
new file mode 100644
index 0000000..74c8063
--- /dev/null
+++ b/linux/src/serpantinum.rs
@@ -0,0 +1,140 @@
+//! Solid parts of Serpantinum layer surfaces, in logical pixels relative to their output.
+use std::collections::BTreeMap;
+use std::io::{self, BufRead};
+use std::path::PathBuf;
+use std::thread;
+
+use calloop::channel::Sender;
+use serde::Deserialize;
+
+use crate::snow::Command;
+use crate::source::{Report, Window};
+use crate::wallpaper::{Placement, Wallpaper};
+
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+pub struct Surface {
+    id: String,
+    output: String,
+    kind: String,
+    x: f64,
+    y: f64,
+    w: f64,
+    h: f64,
+    radius: f32,
+}
+
+pub fn watch(commands: Sender<Command>) {
+    if std::env::var_os("SERPANTINUM_SNOWHUSH_WALLPAPERS").is_none() {
+        return;
+    }
+    let _ = thread::Builder::new().name("serpantinum surfaces".into()).spawn(move || {
+        for line in io::stdin().lock().lines().map_while(Result::ok) {
+            if let Ok(surfaces) = serde_json::from_str(&line)
+                && commands.send(Command::ShellSurfaces(surfaces)).is_err()
+            {
+                return;
+            }
+        }
+        let _ = commands.send(Command::Quit);
+    });
+}
+
+pub fn is_shell(window: &Window) -> bool {
+    window.id.starts_with("serpantinum:")
+}
+
+pub fn add_surfaces(report: &mut Report, surfaces: &[Surface]) {
+    let mut front = Vec::new();
+    let mut behind = Vec::new();
+    for surface in surfaces {
+        let Some(display) = report.screens.iter().find(|display| display.name == surface.output) else { continue };
+        let x = surface.x.max(0.0);
+        // Keep a narrow falling area even when a bar is flush with the top edge.
+        let y = surface.y.max(2.0);
+        let w = (surface.x + surface.w).min(display.w) - x;
+        let h = (surface.y + surface.h).min(display.h) - y;
+        if w < 32.0 || h < 14.0 || w * h >= 0.9 * display.w * display.h {
+            continue;
+        }
+        let widget = surface.kind == "widgets";
+        let id = format!("serpantinum:{}", surface.id);
+        if widget && report.windows.iter().any(|window| {
+            window.solid && window.x < display.x + display.w && window.x + window.w > display.x
+                && window.y < display.y + display.h && window.y + window.h > display.y
+        }) {
+            report.elsewhere.push(id);
+            continue;
+        }
+        let window = Window {
+            id,
+            class: format!("Serpantinum {}", surface.kind),
+            x: x + display.x,
+            y: y + display.y,
+            w,
+            h,
+            solid: true,
+            full: false,
+            above: !widget,
+            decorated: false,
+            maximized: false,
+            radius: Some(surface.radius.max(0.0)),
+        };
+        if widget { behind.push(window) } else { front.push(window) }
+    }
+    front.sort_by_key(|window| !window.class.ends_with("panels"));
+    front.append(&mut report.windows);
+    front.extend(behind);
+    report.windows = front;
+}
+
+pub fn wallpapers() -> Vec<(String, Wallpaper)> {
+    let Some(file) = std::env::var_os("SERPANTINUM_SNOWHUSH_WALLPAPERS") else { return Vec::new() };
+    let Ok(contents) = std::fs::read(file) else { return Vec::new() };
+    let Ok(paths) = serde_json::from_slice::<BTreeMap<String, PathBuf>>(&contents) else { return Vec::new() };
+    paths
+        .into_iter()
+        .filter_map(|(screen, path)| {
+            let extension = path.extension()?.to_str()?.to_ascii_lowercase();
+            if !matches!(extension.as_str(), "png" | "jpg" | "jpeg" | "webp") {
+                return None;
+            }
+            Wallpaper::new(path, Placement::Fill, [0.0; 3]).map(|wallpaper| (screen, wallpaper))
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::source::Display;
+    use crate::windows::{self, Area};
+
+    #[test]
+    fn only_visible_shell_surface_bounds_are_used_and_accumulation_is_independent() {
+        let display = Display { name: "test".into(), x: -1920.0, y: 100.0, w: 1920.0, h: 1080.0, ax: -1920.0, ay: 144.0, aw: 1920.0, ah: 1036.0 };
+        let area = Area::bounds(&display);
+        let mut report = Report { screens: vec![display], ..Default::default() };
+        let surfaces = [
+            Surface { id: "clock".into(), output: "test".into(), kind: "widgets".into(), x: 20.0, y: 60.0, w: 180.0, h: 120.0, radius: 12.0 },
+            Surface { id: "bar".into(), output: "test".into(), kind: "bar".into(), x: 40.0, y: 0.0, w: 120.0, h: 32.0, radius: 8.0 },
+            Surface {
+                id: "transparent-overlay".into(),
+                output: "test".into(),
+                kind: "panels".into(),
+                x: 0.0,
+                y: 0.0,
+                w: 1920.0,
+                h: 1080.0,
+                radius: 0.0,
+            },
+            Surface { id: "unplugged".into(), output: "gone".into(), kind: "widgets".into(), x: 20.0, y: 60.0, w: 180.0, h: 120.0, radius: 12.0 },
+        ];
+        add_surfaces(&mut report, &surfaces);
+        assert_eq!(report.windows.len(), 2);
+        assert_eq!((report.windows[1].x, report.windows[1].y), (-1900.0, 160.0));
+        assert!(windows::surfaces(&report, &area, None, "test", true, false).is_empty());
+        let ledges = windows::surfaces(&report, &area, None, "test", false, true);
+        assert_eq!(ledges.len(), 2);
+        assert_eq!(ledges[1].corner_radius, 12.0);
+    }
+}
